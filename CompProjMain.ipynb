    "\n",
    "for j in range (20):\n",
    "    plt.ylabel(r'$\\rho_{n \\uparrow}$')\n",
    "    plt.xlabel(r'time ($t$)')\n",
    "    plt.title(f'Task B $\\Delta = {20+j*0.25}$')\n",
    "    for n in range(L):\n",
    "        p_up = np.zeros(1000)   \n",
    "        for m in range(L):\n",
    "            p_up += cn_lambdat2(t,n+1,m+1,20+j*0.25)\n",
    "        plt.plot(t,p_up, label=f'n= {n+1}')  \n",
    "    plt.legend()\n",
    "    plt.grid()\n",
    "    plt.savefig(f\"upDelta{20+j*0.25}.png\", dpi=300, bbox_inches=\"tight\")\n",
    "    plt.show()"
   ]
