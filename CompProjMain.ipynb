    "L = 6 #length of the chain\n",
    "V = -1\n",
    "t_start = 0\n",
    "t_end = 20\n",
    "#h_bar = 1.05457182e-34\n",
    "h_bar = 1\n",
    "epsilon1 = -2\n",
    "t=np.linspace(t_start,t_end,1000)\n",
    "H0 =  np.array([\n",
    "    [0, V,  0,  0,  0,  0],\n",
    "    [V,  0, V,  0,  0,  0],\n",
    "    [0,  V,  0, V,  0,  0],\n",
    "    [0,  0, V,  0, V,  0],\n",
    "    [0,  0,  0, V, 0, V],\n",
    "    [0,  0,  0,  0, V, 0]\n",
    "])\n",
    "E_lambda1, eigenvectors1 = np.linalg.eigh(H0)\n",
    "c0 = eigenvectors1[:,0]\n",
    "\n",
    "H1 = np.array([\n",
    "    [epsilon1, V,  0,  0,  0,  0],\n",
    "    [V,  0, V,  0,  0,  0],\n",
    "    [0,  V,  0, V,  0,  0],\n",
    "    [0,  0, V,  0, V,  0],\n",
    "    [0,  0,  0, V, 0, V],\n",
    "    [0,  0,  0,  0, V, 0]\n",
    "])\n",
    "\n",
    "E_lambda, eigenvectors = np.linalg.eigh(H1)\n",
    "\n",
    "\n",
    "\n",
    "def cn_lambdat(t,m):\n",
    " def cm():\n",
    "    k = []\n",
    "\n",
    "    for lam in range(L):\n",
    "        b = np.vdot(eigenvectors[:, lam], c0)\n",
    "        k.append(b)\n",
    "\n",
    "    return k\n",
    " \n",
    " y = []\n",
    " for i in range(len(t)):    \n",
    "     a = np.exp((-1j*E_lambda*t[i])/h_bar) *eigenvectors[m-1, :] *cm()\n",
    "     y.append(np.sum(a))\n",
    "     \n",
    " return  np.abs(np.array(y))**2\n",
    "\n",
    "print(E_lambda)"
   ]
  },
